# Development environment variables for Docker Compose
# These are safe defaults for local development only

# Database (used by both backend and db service)
POSTGRES_PASSWORD=postgres

# Backend
DATABASE_URL=postgresql://postgres:postgres@db:5432/jobRoles?schema=public
JWT_SECRET=dev-local-jwt-secret-change-me-in-production

# Frontend
SESSION_SECRET=dev-session-secret-change-me-in-production
AUTH_LOGIN_PATH=/api/login
API_BASE_URL=http://backend:4000
NODE_ENV=development
PORT=3000
