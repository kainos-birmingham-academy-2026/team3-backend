model JobRole {
  jobRoleId             Int        @id @default(autoincrement())
  roleName              String     @db.VarChar(100)
  description           String
  responsibilities      String
  sharepointUrl         String     @db.VarChar(255)
  numberOfOpenPositions Int
  closingDate           DateTime?
  capabilityId          Int
  bandId                Int
  locationId            Int
  statusId              Int
  capability            Capability @relation(fields: [capabilityId], references: [capabilityId], onDelete: Restrict, onUpdate: Cascade)
  band                  Band       @relation(fields: [bandId], references: [bandId], onDelete: Restrict, onUpdate: Cascade)
  location              Location   @relation(fields: [locationId], references: [locationId], onDelete: Restrict, onUpdate: Cascade)
  status                Status     @relation(fields: [statusId], references: [statusId], onDelete: Restrict, onUpdate: Cascade)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
}

model Capability {
  capabilityId   Int       @id @default(autoincrement())
  capabilityName String    @unique @db.VarChar(100)
  jobRoles       JobRole[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Band {
  bandId    Int       @id @default(autoincrement())
  bandName  String    @unique @db.VarChar(100)
  jobRoles  JobRole[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Status {
  statusId   Int        @id @default(autoincrement())
  statusName StatusEnum @unique
  jobRoles   JobRole[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Location {
  locationId   Int       @id @default(autoincrement())
  locationName String    @unique @db.VarChar(100)
  addressLine1 String    @db.VarChar(255)
  addressLine2 String?   @db.VarChar(255)
  postcode     String    @db.VarChar(20)
  jobRoles     JobRole[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
}
